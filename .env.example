DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
OWNER_USER_ID=YOUR_DISCORD_USER_ID

OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_MODEL=openrouter/free

OPENROUTER_SITE_URL=https://rjryt.com
OPENROUTER_SITE_NAME=RJRYT Discord AI

# OpenRouter server tools
OPENROUTER_WEB_SEARCH=true
# auto lets OpenRouter choose a search engine. Web search may have tool-provider charges.
OPENROUTER_WEB_SEARCH_ENGINE=auto
# OPENROUTER_WEB_SEARCH_MODE=fast

OPENROUTER_WEB_FETCH=true
# OpenRouter direct fetch is free. Other fetch engines may have charges.
OPENROUTER_WEB_FETCH_ENGINE=openrouter
OPENROUTER_WEB_FETCH_MAX_CONTENT_TOKENS=30000

OPENROUTER_DATETIME=true
OPENROUTER_TIMEZONE=Asia/Kolkata

# Autochat is configured persistently with /autochat setup|enable|disable|status|list.
CHANNEL_HISTORY=50
MAX_AI_TOOL_LOOPS=10
CONFIRMATION_SECONDS=30
AI_COOLDOWN_MS=2500
AUTOCHAT_COOLDOWN_MS=8000
STATUS_HEARTBEAT_MS=2500
OPENROUTER_MAX_RETRIES=4
OPENROUTER_RETRY_BASE_MS=1200
